{
  "containerDefinitions": [
    {
      "name": "syscall-RunShellUntrusted",
      "image": "falcosecurity/event-generator:main",
      "cpu": 0,
      "portMappings": [],
      "essential": true,
      "command": [
        "run",
        "syscall.RunShellUntrusted",
        "--loop",
        "--sleep",
        "60s"
      ],
      "mountPoints": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/Syscall-RunShellUntrusted",
          "awslogs-region": "ap-southeast-2",
          "awslogs-stream-prefix": "app"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "/usr/bin/event-generator list"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3
      },
      "systemControls": []
    }
  ],
  "family": "example-event-generator",
  "executionRoleArn": "arn:aws:iam::111122223333:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "volumes": [],
  "placementConstraints": [],
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512"
}
